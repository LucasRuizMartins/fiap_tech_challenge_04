# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais:
# cp .env.example .env

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
ID_CONTA=seu_id_de_conta_aqui
BUCKET_NAME=postech-challenge-datascience-004


GOOGLE_API_KEY= sua_api_gemini
#TAVILY_API_KEY=  ## Pegue uma chave gratuita de buscas em: https://tavily.com
## OPENAI_API_KEY="SUA CHAVE AQUI"
#HF_TOKEN= ## Pegue uma chave gratuita de buscas em: https://huggingface.co/settings/tokens

GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
#OPENAI_CHAT_MODEL=<seu modelo aqui>

LLM_PROVIDER=auto # aceita 'google', 'openai' ou 'auto'

API_KEY_ANALISTA=analista123
API_KEY_DIRETORIA=diretoria123

CORS_ORIGENS=http://localhost:3000
DEBUG_ERROS=1